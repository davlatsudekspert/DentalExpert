        {
          "en": "Soft consistency, loss of knife-edge contour",
          "ru": "Мягкая консистенция, потеря тонкого края",
          "uz": "Yumshoq konsistensiya, yupqa chetning yo‘qolishi"
        },
        {
          "en": "No attachment loss",
          "ru": "Нет потери прикрепления",
          "uz": "Birikish yo‘qolmaydi"
        }
      ]
    },
    {
      "q": {
