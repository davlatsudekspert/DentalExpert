          "label": {
            "en": "Acid attack",
            "ru": "Атака кислоты",
            "uz": "Kislota hujumi"
          },
          "detail": {
            "en": "Acid dissolves the glass surface",
            "ru": "Кислота растворяет поверхность частиц стекла",
            "uz": "Kislota shisha zarrachalari sirtini eritadi"
          }
        },
        {
          "label": {
            "en": "Ion release",
            "ru": "Высвобождение ионов",
            "uz": "Ionlar ajraladi"
          },
          "detail": {
            "en": "Ca, Al and F ions are released",
            "ru": "Выделяются ионы Ca, Al и F",
            "uz": "Ca, Al va F ionlari chiqadi"
          }
        },
        {
          "label": {
            "en": "Calcium polyacrylate",
            "ru": "Полиакрилат кальция",
            "uz": "Kalsiy poliakrilat"
          },
          "detail": {
            "en": "Early set, moisture-sensitive",
            "ru": "Начальное твердение, чувствительно к влаге",
            "uz": "Dastlabki qotish, namlikka sezgir"
